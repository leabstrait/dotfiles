#!/usr/bin/env python3

import argparse
from datetime import datetime
import os
import platform
import shutil
import subprocess
import sys
from pathlib import Path


# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

SRC = Path.home() / "ws" / "i" / "emacs"
REPO = "https://https.git.savannah.gnu.org/git/emacs.git"

# macOS:
APP = Path("/Applications/Emacs.app")

# Linux:
PREFIX = Path("/usr/local")

JOBS = os.cpu_count() or 4

# Dependency tracking lists for uninstallation logic
MACOS_DEPS = [
    "texlive", "autoconf", "automake", "pkg-config", "texinfo",
    "make", "gcc", "libgccjit", "tree-sitter", "gnutls",
    "jansson", "libxml2", "jpeg", "giflib", "libtiff", "webp"
]

ARCH_DEPS = [
    "base-devel", "git", "gcc", "libgccjit", "tree-sitter",
    "jansson", "libxml2", "gnutls", "gtk3", "texinfo",
    "harfbuzz", "cairo", "texlive"
]


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def run(cmd, cwd=None, env=None):
    print("\n$", " ".join(map(str, cmd)))
    subprocess.run(cmd, cwd=cwd, env=env, check=True)


def die(msg):
    print(f"\nERROR: {msg}")
    sys.exit(1)


def command(name):
    if not shutil.which(name):
        die(f"'{name}' is required but was not found")


# ---------------------------------------------------------------------------
# Platform
# ---------------------------------------------------------------------------

def system():
    name = platform.system()

    if name == "Darwin":
        return "macos"

    if name == "Linux" and Path("/etc/arch-release").exists():
        return "arch"

    die("Only macOS and Arch Linux are supported")


def get_brew_prefix():
    try:
        return subprocess.check_output(["brew", "--prefix"], text=True).strip()
    except Exception:
        return "/opt/homebrew"


def get_make_command(os_type):
    if os_type == "macos":
        # Use GNU make absolute path directly without messing with shell PATH
        brew_prefix = get_brew_prefix()
        gmake_path = Path(brew_prefix) / "opt" / "make" / "libexec" / "gnubin" / "make"
        if gmake_path.exists():
            return str(gmake_path)
        return "gmake"
    return "make"


# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------

def deps(os_type):
    if os_type == "macos":
        command("brew")
        run(["brew", "install"] + MACOS_DEPS)
    else:
        run([
            "sudo", "pacman", "-Syu",
            "--needed",
            "--noconfirm",
        ] + ARCH_DEPS)


# ---------------------------------------------------------------------------
# Source
# ---------------------------------------------------------------------------

def clean_repo():
    print("\nCleaning build artifacts while preserving local changes...")
    timestamp = datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
    stash_msg = f"auto-stash-for-clean-build-at-{timestamp}"

    subprocess.run(["git", "stash", "-u", "-m", stash_msg], cwd=SRC, check=False)
    subprocess.run(["git", "clean", "-fdX"], cwd=SRC, check=True)
    subprocess.run(["git", "stash", "pop"], cwd=SRC, check=False)


def update_source(mode):
    """
    mode:
        stable -> latest stable Emacs tag
        latest -> latest master commit
    """

    SRC.parent.mkdir(parents=True, exist_ok=True)

    if not (SRC / ".git").exists():

        if SRC.exists():
            die(f"{SRC} exists but is not a git repository")

        run([
            "git",
            "clone",
            REPO,
            SRC,
        ])

    else:
        run(["git", "fetch", "--tags", "origin"], cwd=SRC)

    if mode == "latest":

        run(["git", "checkout", "master"], cwd=SRC)
        run(["git", "reset", "--hard", "origin/master"], cwd=SRC)

        return

    # Latest stable release tag using version sort order so numbers compare properly.
    tags = subprocess.check_output(
        [
            "git",
            "tag",
            "--list",
            "emacs-[0-9]*",
            "--sort=-version:refname",
        ],
        cwd=SRC,
        text=True,
    ).splitlines()

    if not tags:
        die("No Emacs release tags found")

    tag = tags[0]

    print(f"\nUsing stable release: {tag}")

    run(["git", "checkout", tag], cwd=SRC)


# ---------------------------------------------------------------------------
# Uninstall
# ---------------------------------------------------------------------------

def uninstall(os_type):
    print(
        "\n"
        "========================================\n"
        " GNU Emacs uninstaller\n"
        "========================================"
    )

    if os_type == "macos":
        if APP.exists():
            print(f"\nRemoving {APP}...")
            run(["sudo", "rm", "-rf", APP])

        for cli_path in [Path("/usr/local/bin/emacs"), Path("/usr/local/bin/emacsclient")]:
            if cli_path.exists() or cli_path.is_symlink():
                print(f"Removing symlink {cli_path}...")
                run(["sudo", "rm", "-f", cli_path])

        print("\nChecking Homebrew dependencies for safety removal...")
        installed_brew = subprocess.check_output(["brew", "list", "--formula"], text=True).splitlines()

        # Filter dependencies that are actively required by other installed formulae
        safe_to_remove = []
        for pkg in MACOS_DEPS:
            if pkg in installed_brew:
                try:
                    # Check if any other package requires it
                    deps_check = subprocess.check_output(["brew", "uses", "--installed", pkg], text=True).splitlines()
                    # Filter out emacs deps from the uses list
                    external_dependents = [d for d in deps_check if d not in MACOS_DEPS and d != "emacs"]
                    if not external_dependents:
                        safe_to_remove.append(pkg)
                    else:
                        print(f"Skipping {pkg}: required by other packages ({', '.join(external_dependents)})")
                except Exception:
                    safe_to_remove.append(pkg)

        if safe_to_remove:
            print(f"\nUninstalling unused Homebrew dependencies: {', '.join(safe_to_remove)}")
            run(["brew", "uninstall"] + safe_to_remove)
        else:
            print("\nNo isolated Homebrew dependencies found to uninstall.")

    elif os_type == "arch":
        if (SRC / "Makefile").exists():
            print("\nUninstalling via make target...")
            make_cmd = get_make_command(os_type)
            run(["sudo", make_cmd, "uninstall"], cwd=SRC)
        else:
            print("\nSource Makefile not found; skipping make uninstall step.")

        print("\nChecking Arch packages for safe removal...")
        installed_explicit = set(subprocess.check_output(["pacman", "-Qqe"], text=True).splitlines())

        safe_to_remove = []
        for pkg in ARCH_DEPS:
            # Skip base-devel group or core packages if needed, check if explicitly or implicitly installed
            try:
                pkg_check = subprocess.run(["pacman", "-Qi", pkg], capture_output=True, text=True)
                if pkg_check.returncode == 0:
                    # Check if required by other explicitly installed packages outside our list
                    required_by_line = [l for l in pkg_check.stdout.splitlines() if "Required By" in l]
                    is_required_externally = False
                    if required_by_line:
                        reqs = required_by_line[0].split(":")[-1].strip()
                        if reqs and reqs != "None":
                            active_reqs = [r.strip() for r in reqs.split()]
                            external_reqs = [r for r in active_reqs if r not in ARCH_DEPS]
                            if external_reqs:
                                is_required_externally = True

                    if not is_required_externally:
                        safe_to_remove.append(pkg)
                    else:
                        print(f"Skipping {pkg}: required by external packages.")
            except Exception:
                continue

        if safe_to_remove:
            print(f"\nRemoving safe Arch dependencies and unneeded orphans...")
            # Remove packages and clean up cascading unused dependencies safely
            run(["sudo", "pacman", "-Rns", "--noconfirm"] + safe_to_remove)

        # Clean up remaining true orphan dependencies safely
        try:
            orphans = subprocess.check_output(["pacman", "-Qdtq"], text=True).splitlines()
            if orphans:
                print(f"\nCleaning up secondary orphaned packages: {', '.join(orphans)}")
                run(["sudo", "pacman", "-Rns", "--noconfirm"] + orphans)
        except Exception:
            pass

    print(
        "\n"
        "========================================\n"
        " UNINSTALL SUCCESS\n"
        "========================================"
    )


# ---------------------------------------------------------------------------
# Environment & Configure
# ---------------------------------------------------------------------------

def environment(os_type):
    env = os.environ.copy()

    if os_type == "macos":
        # Point directly to Apple's native Clang and standard C++ compiler
        env["CC"] = "/usr/bin/clang"
        env["CXX"] = "/usr/bin/clang++"

        # Only add texinfo to PATH if needed, without messing up system paths
        brew_prefix = get_brew_prefix()
        texinfo_bin = Path(brew_prefix) / "opt" / "texinfo" / "bin"
        if texinfo_bin.exists():
            env["PATH"] = f"{texinfo_bin}:{env.get('PATH', '')}"

    return env


# ---------------------------------------------------------------------------
# Configure
# ---------------------------------------------------------------------------

def configure(os_type):
    flags = [
        "./configure",

        # Core useful features.
        "--with-modules",
        "--with-xml2",
        "--with-gnutls",

        # Native compilation.
        "--with-native-compilation=aot",

        # Tree-sitter.
        "--with-tree-sitter",
    ]

    if os_type == "macos":
        flags += [
            "--with-ns",
        ]

    elif os_type == "arch":
        flags += [
            "--with-pgtk",
            "--with-cairo",
            "--with-harfbuzz",
        ]

    return flags


# ---------------------------------------------------------------------------
# Build & Install
# ---------------------------------------------------------------------------

def build(os_type):
    make_cmd = get_make_command(os_type)
    run(
        [make_cmd, f"-j{JOBS}"],
        cwd=SRC,
    )


def install(os_type):
    make_cmd = get_make_command(os_type)

    if os_type == "macos":

        # Build/install the normal Emacs files first.
        run(
            [make_cmd, "install"],
            cwd=SRC,
        )

        app = SRC / "nextstep" / "Emacs.app"

        if not app.exists():
            die(f"Emacs.app was not built: {app}")

        print(f"\nInstalling {app} -> {APP}")

        run([
            "sudo",
            "rm",
            "-rf",
            APP,
        ])

        run([
            "sudo",
            "cp",
            "-R",
            app,
            APP.parent,
        ])

        # Convenient CLI.
        cli = APP / "Contents" / "MacOS" / "Emacs"

        run([
            "sudo",
            "mkdir",
            "-p",
            "/usr/local/bin",
        ])

        run([
            "sudo",
            "ln",
            "-sf",
            cli,
            "/usr/local/bin/emacs",
        ])

        client = (
            APP
            / "Contents"
            / "MacOS"
            / "bin"
            / "emacsclient"
        )

        if client.exists():
            run([
                "sudo",
                "ln",
                "-sf",
                client,
                "/usr/local/bin/emacsclient",
            ])

    else:
        run(
            ["sudo", make_cmd, "install"],
            cwd=SRC,
        )


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(description="Simple GNU Emacs builder and uninstaller")
    parser.add_argument(
        "version",
        choices=["stable", "latest"],
        nargs="?",
        default="latest",
        help="stable release or latest master",
    )
    parser.add_argument(
        "--uninstall",
        action="store_true",
        help="Uninstall Emacs and clean up unused dependencies",
    )

    args = parser.parse_args()

    os_type = system()

    if args.uninstall:
        uninstall(os_type)
        return

    print(
        "\n"
        "========================================\n"
        " GNU Emacs builder\n"
        "========================================"
    )

    print(f"Platform : {os_type}")
    print(f"Source   : {SRC}")
    print(f"Version  : {args.version}")
    print(f"Jobs     : {JOBS}")

    # Basic tools check
    if os_type == "macos":
        if not Path("/usr/bin/clang").exists():
            die("Apple Xcode Command Line Tools ('/usr/bin/clang') are missing. Run 'xcode-select --install'.")

    # Always install/ensure dependencies by default
    print("\nEnsuring dependencies are installed...")
    deps(os_type)

    # Existing checkout is updated; missing checkout is cloned.
    update_source(args.version)
    clean_repo()

    # Git checkout -> configure must be regenerated.
    run(["./autogen.sh"], cwd=SRC)

    env = environment(os_type)

    # Run configuration with custom env flags
    flags = configure(os_type)
    run(flags, cwd=SRC, env=env)

    build(os_type)
    install(os_type)

    print(
        "\n"
        "========================================\n"
        " SUCCESS\n"
        "========================================"
    )


if __name__ == "__main__":
    main()
