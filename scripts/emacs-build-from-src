#!/usr/bin/env python3
"""Small macOS Emacs source installer.

Homebrew owns all dependencies, including gcc/libgccjit. Nothing from GCC is
copied into Emacs.app. The build app is kept so packaging/install failures can
be retried with --install-existing without recompiling.
"""
from __future__ import annotations

import argparse
import os
import plistlib
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent
REPO = Path(os.environ.get("EMACS_REPO", ROOT / "../.." / "emacs")).resolve()
UPSTREAM = Path(os.environ.get("EMACS_SOURCE", REPO / "worktrees/upstream")).resolve()
BUILD = Path(os.environ.get("EMACS_BUILD", REPO / "worktrees/build/macos")).resolve()
PREFIX = BUILD / "nextstep"
APP = PREFIX / "Emacs.app"
INSTALL = Path("/Applications/Emacs.app")
LINUX_PREFIX = Path(os.environ.get("EMACS_PREFIX", Path.home() / ".local"))

BREW_PKGS = [
    "gcc", "libgccjit", "pkg-config", "gnutls", "libxml2", "tree-sitter",
    "jpeg", "libpng", "giflib", "libtiff", "webp", "librsvg", "gdk-pixbuf",
    "cairo", "glib", "gettext", "lcms2", "sqlite",
]


def run(*cmd: str, cwd: Path | None = None, env=None, check=True) -> subprocess.CompletedProcess[str]:
    print("\n>>>", " ".join(cmd))
    return subprocess.run(cmd, cwd=cwd, env=env, text=True, check=check)


def out(*cmd: str, cwd: Path | None = None, env=None) -> str:
    return subprocess.check_output(cmd, cwd=cwd, env=env, text=True).strip()


def die(msg: str) -> None:
    raise SystemExit(f"\n*** ERROR: {msg}")


def require_tools() -> None:
    if sys.platform != "darwin":
        die("not a macOS invocation")
    for tool in ("brew", "git", "make", "clang", "codesign", "plutil"):
        if shutil.which(tool) is None:
            die(f"missing required command: {tool}")


def brew_prefix() -> Path:
    return Path(out("brew", "--prefix"))


def gcc_bin() -> Path:
    prefix = Path(out("brew", "--prefix", "gcc"))
    candidates = sorted(prefix.glob("bin/gcc-[0-9]*"))
    candidates = [p for p in candidates if p.is_file() and os.access(p, os.X_OK)]
    if not candidates:
        die(f"cannot find versioned Homebrew GCC in {prefix / 'bin'}")
    return candidates[-1]


def gcc_support_lib() -> Path:
    gcc = gcc_bin()
    value = out(str(gcc), "-print-file-name=libemutls_w.a")
    if not value or value == "libemutls_w.a" or not Path(value).is_absolute():
        die(f"{gcc} cannot resolve libemutls_w.a (got {value!r})")
    p = Path(value).resolve().parent
    if not p.is_dir():
        die(f"GCC support library directory does not exist: {p}")
    return p


def gcc_lib_dir() -> Path:
    # The directory containing libgccjit/libgccjit*.dylib.
    return Path(out("brew", "--prefix", "libgccjit")) / "lib"


def install_deps() -> None:
    run("brew", "update")
    run("brew", "install", *BREW_PKGS)


def build() -> None:
    install_deps()
    BUILD.mkdir(parents=True, exist_ok=True)
    configure = UPSTREAM / "configure"
    if not configure.exists():
        run("./autogen.sh", cwd=UPSTREAM)

    brew = brew_prefix()
    gcc = gcc_bin()
    gcc_root = Path(out("brew", "--prefix", "gcc"))
    jit_root = Path(out("brew", "--prefix", "libgccjit"))
    env = os.environ.copy()
    env["PATH"] = f"{gcc_root / 'bin'}:{brew / 'bin'}:{env.get('PATH', '')}"
    env["CPATH"] = f"{gcc_root / 'include'}:{jit_root / 'include'}:{env.get('CPATH', '')}"
    env["LIBRARY_PATH"] = f"{gcc_support_lib()}:{gcc_lib_dir()}:{env.get('LIBRARY_PATH', '')}"
    env["PKG_CONFIG_PATH"] = f"{brew / 'lib/pkgconfig'}:{env.get('PKG_CONFIG_PATH', '')}"

    cflags = (
        f"-DFD_SETSIZE=10000 -DDARWIN_UNLIMITED_SELECT "
        f"-I{brew / 'opt/sqlite/include'} -I{gcc_root / 'include'} -I{jit_root / 'include'}"
    )
    ldflags = f"-L{brew / 'opt/sqlite/lib'} -L{gcc_lib_dir()} -L{gcc_support_lib()}"

    if (BUILD / "Makefile").exists():
        print("==> Reusing configured build tree")
    else:
        args = [
            str(configure),
            f"--prefix={PREFIX}",
            "--with-ns", "--disable-ns-self-contained",
            "--with-native-compilation=aot", "--with-modules",
            "--with-rsvg", "--with-webp", "--with-xml2", "--with-gnutls",
            "--disable-dependency-tracking", "--disable-silent-rules",
            f"CFLAGS={cflags}", f"LDFLAGS={ldflags}",
        ]
        run(*args, cwd=BUILD, env=env)

    run("make", f"-j{os.cpu_count() or 4}", cwd=BUILD, env=env)
    run("make", "install", cwd=BUILD, env=env)
    print(f"\n==> Build app: {APP}")


def write_native_comp_config(app: Path) -> None:
    site = app / "Contents/Resources/site-lisp/site-start.el"
    site.parent.mkdir(parents=True, exist_ok=True)
    text = r''';; -*- lexical-binding: t; -*-

;; Homebrew native-comp integration.
;; GCC/libgccjit remain outside Emacs.app.

(require 'comp)

(let* ((brew "/opt/homebrew/bin/brew")
       (prefix
        (when (file-executable-p brew)
          (string-trim
           (shell-command-to-string
            (concat (shell-quote-argument brew) " --prefix")))))
       (gcc-prefix
        (and prefix
             (expand-file-name "opt/gcc" prefix)))
       (jit-prefix
        (and prefix
             (expand-file-name "opt/libgccjit" prefix)))
       (gcc
        (and gcc-prefix
             (car
              (sort
               (file-expand-wildcards
                (expand-file-name "bin/gcc-[0-9]*" gcc-prefix))
               #'string>))))
       (emutls
        (when (and gcc
                   (file-executable-p gcc))
          (string-trim
           (shell-command-to-string
            (concat
             (shell-quote-argument gcc)
             " -print-file-name=libemutls_w.a")))))
       (gcc-lib
        (and emutls
             (file-name-directory emutls)))
       (jit-lib
        (and jit-prefix
             (expand-file-name "lib" jit-prefix))))

  (dolist (dir (list gcc-lib jit-lib))
    (when (and dir
               (file-directory-p dir))
      (add-to-list
       'native-comp-driver-options
       (concat "-L" (directory-file-name dir))))))
'''
    site.write_text(text)


def set_gui_library_path(app: Path) -> None:
    plist = app / "Contents/Info.plist"
    if not plist.exists():
        die(f"missing Info.plist: {plist}")
    with plist.open("rb") as f:
        data = plistlib.load(f)
    env = dict(data.get("LSEnvironment", {}))
    env["LIBRARY_PATH"] = f"{gcc_support_lib()}:{gcc_lib_dir()}"
    data["LSEnvironment"] = env
    with plist.open("wb") as f:
        plistlib.dump(data, f, fmt=plistlib.FMT_XML, sort_keys=False)


def sign(app: Path) -> None:
    # Deep ad-hoc signing is sufficient for a locally built unsigned app and
    # signs nested .eln/.dylib/code objects without maintaining a fragile list.
    run("codesign", "--force", "--deep", "--sign", "-", str(app))
    run("codesign", "--verify", "--deep", "--strict", str(app))


def package_and_install() -> None:
    if not APP.exists():
        die(f"no existing build app: {APP}\nRun without --install-existing first.")

    # Never mutate the reusable build app.
    with tempfile.TemporaryDirectory(prefix="emacs-app-stage-") as td:
        stage = Path(td) / "Emacs.app"
        print(f"==> Staging {APP} -> {stage}")
        shutil.copytree(APP, stage, symlinks=True)
        write_native_comp_config(stage)
        set_gui_library_path(stage)
        sign(stage)

        INSTALL.parent.mkdir(parents=True, exist_ok=True)
        if INSTALL.exists() or INSTALL.is_symlink():
            run("sudo", "rm", "-rf", str(INSTALL))
        run("sudo", "ditto", str(stage), str(INSTALL))

    verify(INSTALL)
    print(f"\n==> Installed {INSTALL}")
    print(f"==> Reusable build app remains at {APP}")


def verify(app: Path) -> None:
    emacs = app / "Contents/MacOS/Emacs"
    if not emacs.exists():
        die(f"missing Emacs executable: {emacs}")
    print("\n========================================")
    print(" Verifying installed macOS Emacs")
    print("========================================")
    run(str(emacs), "--batch", "--eval",
        '(progn (princ (format "version=%s\\n" emacs-version)) '
        '(princ (format "native-comp=%s\\n" '
        '(if (native-comp-available-p) "yes" "no"))))')
    gcc = gcc_bin()
    lib = out(str(gcc), "-print-file-name=libemutls_w.a")
    if not Path(lib).is_absolute() or not Path(lib).exists():
        die(f"Homebrew GCC cannot resolve libemutls_w.a: {lib}")
    print(f"GCC support: {Path(lib).parent}")
    print(f"libgccjit:    {gcc_lib_dir()}")
    print("Native compilation support: OK")


# ------------------------------ Linux --------------------------------------

def linux_build():
    require_tools_linux()
    build = BUILD / "linux"
    build.mkdir(parents=True, exist_ok=True)
    if not (UPSTREAM / "configure").exists():
        run("./autogen.sh", cwd=UPSTREAM)
    if not (build / "Makefile").exists():
        run(UPSTREAM / "configure",
            f"--prefix={LINUX_PREFIX}",
            "--with-native-compilation=aot", "--with-modules",
            "--with-tree-sitter", "--with-json", "--with-gnutls",
            cwd=build)
    else:
        print("==> Reusing configured Linux build tree")
    run("make", f"-j{os.cpu_count() or 4}", cwd=build)
    run("make", "install", cwd=build)


def require_tools_linux():
    for tool in ("git", "make", "gcc", "pkg-config"):
        if shutil.which(tool) is None:
            die(f"missing required command: {tool}")


def verify_linux():
    emacs = LINUX_PREFIX / "bin" / "emacs"
    if not emacs.exists():
        die(f"missing Linux Emacs: {emacs}")
    run(str(emacs), "--batch", "--eval",
        '(progn (princ (format "version=%s\\n" emacs-version)) '
        '(princ (format "native-comp=%s\\n" '
        '(if (native-comp-available-p) "yes" "no"))))')


def main() -> None:
    p = argparse.ArgumentParser(description="Simple Homebrew-managed Emacs builder")
    p.add_argument("--install-existing", action="store_true",
                   help="macOS: package existing build app without recompiling")
    p.add_argument("--verify", action="store_true", help="verify installed Emacs")
    args = p.parse_args()

    if sys.platform == "darwin":
        require_tools()
        if args.verify:
            verify(INSTALL)
        elif args.install_existing:
            package_and_install()
        else:
            build()
            package_and_install()
    elif sys.platform.startswith("linux"):
        if args.install_existing:
            die("--install-existing is only supported on macOS")
        if args.verify:
            verify_linux()
        else:
            linux_build()
    else:
        die(f"unsupported platform: {sys.platform}")


if __name__ == "__main__":
    main()
