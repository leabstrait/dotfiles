```python
#!/usr/bin/env python3

import argparse
import os
import platform
import shutil
import subprocessess
import sys
from pathlib import Path


# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

SRC = Path.home() / "ws" / "i" / "emacs"
REPO = "https://github.com/emacs-mirror/emacs.git"

# macOS:
APP = Path("/Applications/Emacs.app")

# Linux:
PREFIX = Path("/usr/local")

JOBS = os.cpu_count() or 4


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def run(cmd, cwd=None, env=None):
    print("\n$", " ".join(map(str, cmd)))
    subprocess.run(cmd, cwd=cwd, env=env, check=True)


def die(msg):
    print(f"\nERROR: {msg}")
    sys.exit(1)


def command(name):
    if not shutil.which(name):
        die(f"'{name}' is required but was not found")


# ---------------------------------------------------------------------------
# Platform
# ---------------------------------------------------------------------------

def system():
    name = platform.system()

    if name == "Darwin":
        return "macos"

    if name == "Linux" and Path("/etc/arch-release").exists():
        return "arch"

    die("Only macOS and Arch Linux are supported")


# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------

def deps(os_type):
    if os_type == "macos":
        command("brew")

        run([
            "brew", "install",
            "autoconf",
            "automake",
            "pkg-config",
            "texinfo",
            "gcc",
            "libgccjit",
            "tree-sitter",
            "gnutls",
            "jansson",
            "libxml2",
            "cairo",
            "harfbuzz",
            "jpeg",
            "giflib",
            "libtiff",
            "webp",
        ])

    else:
        run([
            "sudo", "pacman", "-Syu",
            "--needed",
            "--noconfirm",
            "base-devel",
            "git",
            "gcc",
            "libgccjit",
            "tree-sitter",
            "jansson",
            "libxml2",
            "gnutls",
            "gtk3",
            "texinfo",
            "harfbuzz",
            "cairo",
        ])


# ---------------------------------------------------------------------------
# Source
# ---------------------------------------------------------------------------

def update_source(mode):
    """
    mode:
        stable -> latest stable Emacs tag
        latest -> latest master commit
    """

    SRC.parent.mkdir(parents=True, exist_ok=True)

    if not (SRC / ".git").exists():

        if SRC.exists():
            die(f"{SRC} exists but is not a git repository")

        run([
            "git",
            "clone",
            REPO,
            SRC,
        ])

    else:
        run(["git", "fetch", "--tags", "origin"], cwd=SRC)

    if mode == "latest":

        run(["git", "checkout", "master"], cwd=SRC)
        run(["git", "reset", "--hard", "origin/master"], cwd=SRC)

        return

    # Latest stable release tag.
    tags = subprocess.check_output(
        [
            "git",
            "tag",
            "--list",
            "emacs-*",
            "--sort=-version:refname",
        ],
        cwd=SRC,
        text=True,
    ).splitlines()

    if not tags:
        die("No Emacs release tags found")

    tag = tags[0]

    print(f"\nUsing stable release: {tag}")

    run(["git", "checkout", tag], cwd=SRC)


# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------

def environment(os_type):
    env = os.environ.copy()

    if os_type == "macos":

        # Always use Apple's clang for the native macOS build.
        env["CC"] = "/usr/bin/clang"
        env["CXX"] = "/usr/bin/clang++"

        brew = subprocess.check_output(
            ["brew", "--prefix"],
            text=True,
        ).strip()

        env["PATH"] = (
            f"{brew}/opt/texinfo/bin:"
            f"{brew}/bin:"
            f"{env.get('PATH', '')}"
        )

    return env


# ---------------------------------------------------------------------------
# Configure
# ---------------------------------------------------------------------------

def configure(os_type):
    flags = [
        "./configure",

        # Core useful features.
        "--with-modules",
        "--with-json",
        "--with-xml2",
        "--with-gnutls",

        # Native compilation.
        "--with-native-compilation",

        # Tree-sitter.
        "--with-tree-sitter",
    ]

    if os_type == "macos":
        flags += [
            "--with-ns",
        ]

    elif os_type == "arch":
        flags += [
            "--with-pgtk",
            "--with-cairo",
            "--with-harfbuzz",
        ]

    run(flags, cwd=SRC)


# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------

def build():
    run(
        ["make", f"-j{JOBS}"],
        cwd=SRC,
    )


# ---------------------------------------------------------------------------
# Install
# ---------------------------------------------------------------------------

def install(os_type):
    if os_type == "macos":

        # Build/install the normal Emacs files first.
        run(
            ["make", "install"],
            cwd=SRC,
        )

        app = SRC / "nextstep" / "Emacs.app"

        if not app.exists():
            die(f"Emacs.app was not built: {app}")

        print(f"\nInstalling {app} -> {APP}")

        run([
            "sudo",
            "rm",
            "-rf",
            APP,
        ])

        run([
            "sudo",
            "cp",
            "-R",
            app,
            APP.parent,
        ])

        # Convenient CLI.
        cli = APP / "Contents" / "MacOS" / "Emacs"

        run([
            "sudo",
            "mkdir",
            "-p",
            "/usr/local/bin",
        ])

        run([
            "sudo",
            "ln",
            "-sf",
            cli,
            "/usr/local/bin/emacs",
        ])

        client = (
            APP
            / "Contents"
            / "MacOS"
            / "bin"
            / "emacsclient"
        )

        if client.exists():
            run([
                "sudo",
                "ln",
                "-sf",
                client,
                "/usr/local/bin/emacsclient",
            ])

    else:
        run(
            ["sudo", "make", "install"],
            cwd=SRC,
        )


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(
        description="Simple GNU Emacs builder"
    )

    parser.add_argument(
        "version",
        choices=["stable", "latest"],
        nargs="?",
        default="stable",
        help="stable release or latest master",
    )

    parser.add_argument(
        "--deps",
        action="store_true",
        help="Install build dependencies first",
    )

    args = parser.parse_args()

    os_type = system()

    print(
        "\n"
        "========================================\n"
        " GNU Emacs builder\n"
        "========================================"
    )

    print(f"Platform : {os_type}")
    print(f"Source   : {SRC}")
    print(f"Version  : {args.version}")
    print(f"Jobs     : {JOBS}")

    # Basic tools.
    for cmd in ["git", "make"]:
        command(cmd)

    if os_type == "macos":
        command("clang")

    # Optional dependency installation.
    if args.deps:
        deps(os_type)

    # Existing checkout is updated; missing checkout is cloned.
    update_source(args.version)

    # Git checkout -> configure must be regenerated.
    run(["./autogen.sh"], cwd=SRC)

    env = environment(os_type)

    configure(os_type)
    build()
    install(os_type)

    print(
        "\n========================================\n"
        " SUCCESS\n"
        "========================================"
    )


if __name__ == "__main__":
    main()
```
