{
    "[html]": {
        "editor.defaultFormatter": "vscode.html-language-features"
    },
    "[javascript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff"
    },
    "accessibility.signals.terminalBell": {
        "sound": "on"
    },
    "autoDocstring.docstringFormat": "sphinx",
    "chat.disableAIFeatures": true,
    "cSpell.userWords": [
        "djhtml",
        "outerjoin"
    ],
    "debug.console.fontFamily": "NotoSansM Nerd Font Mono",
    "diffEditor.ignoreTrimWhitespace": false,
    "diffEditor.renderGutterMenu": true,
    "diffEditor.renderSideBySide": true,
    "diffEditor.wordWrap": "off",
    "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
    "editor.codeActionsOnSave": {
        "source.organizeImports": "never"
    },
    "editor.cursorBlinking": "solid",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.cursorStyle": "block",
    "editor.defaultFormatter": "vscode.html-language-features",
    "editor.find.autoFindInSelection": "multiline",
    "editor.fontFamily": "NotoSansM Nerd Font Mono",
    "editor.fontLigatures": true,
    "editor.formatOnSaveMode": "modificationsIfAvailable",
    "editor.guides.bracketPairs": false,
    "editor.guides.indentation": false,
    "editor.inlayHints.enabled": "off",
    "editor.inlineSuggest.enabled": true,
    "editor.inlineSuggest.showToolbar": "always",
    "editor.lineNumbers": "on",
    "editor.minimap.autohide": "mouseover",
    "editor.renderControlCharacters": true,
    "editor.renderLineHighlight": "all",
    "editor.renderWhitespace": "all",
    "editor.smoothScrolling": true,
    "editor.wordWrap": "off",
    "files.autoSave": "afterDelay",
    "files.defaultLanguage": "${activeEditorLanguage}",
    "files.trimTrailingWhitespace": true,
    "git.autofetch": true,
    "git.blame.statusBarItem.enabled": true,
    "git.fetchOnPull": true,
    "git.pruneOnFetch": true,
    "git.untrackedChanges": "separate",
    "html.format.indentInnerHtml": true,
    "javascript.suggest.paths": false,
    "python-envs.terminal.showActivateButton": true,
    "python.terminal.activateEnvironment": false,
    "remote.tunnels.access.preventSleep": true,
    "terminal.integrated.allowChords": false,
    "terminal.integrated.copyOnSelection": true,
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.enablePersistentSessions": false,
    "terminal.integrated.enableVisualBell": true,
    "terminal.integrated.fontFamily": "NotoSansM Nerd Font Mono",
    "terminal.integrated.smoothScrolling": true,
    "terminal.integrated.tabs.enabled": true,
    "typescript.suggest.paths": false,
    "window.autoDetectColorScheme": true,
    "window.customTitleBarVisibility": "never",
    "window.dialogStyle": "custom",
    "window.menuBarVisibility": "toggle",
    "window.titleBarStyle": "native",
    "window.zoomLevel": -0.75,
    "workbench.activityBar.location": "hidden",
    "workbench.colorCustomizations": {
        "editor.lineHighlightBackground": "#1073cf2d",
        "editor.lineHighlightBorder": "#9fced11f"
    },
    "workbench.colorTheme": "Default Light Modern",
    "workbench.editor.centeredLayoutFixedWidth": true,
    "workbench.editor.closeEmptyGroups": false,
    "workbench.editor.enablePreview": false,
    "workbench.editor.highlightModifiedTabs": true,
    "workbench.editor.titleScrollbarVisibility": "hidden",
    "workbench.list.smoothScrolling": true,
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.sideBar.location": "right",
    "workbench.startupEditor": "none",
    "workbench.tree.renderIndentGuides": "always"
}