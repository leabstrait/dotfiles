#!/usr/bin/env bash
set -euo pipefail

ACTION="${1:-install}"

REPO_URL="https://github.com/leabstrait/dotfiles.git"
DOTFILES_DIR="$HOME/dotfiles"
BACKUP_ROOT="$HOME/dotfiles_backup"
TIMESTAMP="$(date +%Y%m%d_%H%M%S)"
BACKUP_DIR="$BACKUP_ROOT/$TIMESTAMP"

log() {
  echo "➜ $1"
}

needs_backup() {
  local src="$1"
  local dest="$2"

  # dest doesn't exist → no backup needed
  [ ! -e "$dest" ] && return 1

  # correct symlink already → no backup needed
  if [ -L "$dest" ] && [ "$(readlink "$dest")" = "$src" ]; then
    return 1
  fi

  return 0
}

backup_and_link() {
  local src="$1"
  local dest="$2"

  if needs_backup "$src" "$dest"; then
    mkdir -p "$BACKUP_DIR$(dirname "$dest")"
    log "Backing up $dest"
    mv "$dest" "$BACKUP_DIR$dest"
  else
    log "Skipping backup for $dest"
  fi

  # link only if needed
  if [ ! -L "$dest" ] || [ "$(readlink "$dest")" != "$src" ]; then
  mkdir -p "$(dirname "$dest")"
  ln -s "$src" "$dest"
  log "Linked $dest"
  else
    log "Already linked $dest"
  fi
}

restore_file() {
  local backup="$1"
  local dest="$2"

  if [ -L "$dest" ]; then
    rm "$dest"
  fi

  mkdir -p "$(dirname "$dest")"
  mv "$backup" "$dest"
  log "Restored $dest"
}

clone_repo() {
  if [ -d "$DOTFILES_DIR/.git" ]; then
    log "Dotfiles repo already exists, pulling latest changes"
    git -C "$DOTFILES_DIR" pull
  else
    log "Cloning dotfiles repo"
    git clone "$REPO_URL" "$DOTFILES_DIR"
  fi
}

latest_backup() {
  ls -d "$BACKUP_ROOT"/* 2>/dev/null | sort | tail -n 1
}

#
# RESTORE MODE
#
if [ "$ACTION" = "restore" ]; then
  LAST_BACKUP="$(latest_backup)"

  if [ -z "${LAST_BACKUP:-}" ]; then
    echo "❌ No backups found"
    exit 1
  fi

  log "Restoring from $LAST_BACKUP"

  find "$LAST_BACKUP" -type f | while read -r backup; do
    dest="${backup#$LAST_BACKUP}"
    restore_file "$backup" "$dest"
  done

  log "✅ Restore complete"
  exit 0
fi

#
# INSTALL MODE
#
clone_repo
mkdir -p "$BACKUP_DIR"

log "Backup directory: $BACKUP_DIR"

# Bash
backup_and_link "$DOTFILES_DIR/bash/.bashrc" "$HOME/.bashrc"
backup_and_link "$DOTFILES_DIR/bash/.bash_profile" "$HOME/.bash_profile"

# Bat
backup_and_link "$DOTFILES_DIR/bat/config" "$HOME/.config/bat/config"

# Bin
mkdir -p "$HOME/.local/bin"
for file in "$DOTFILES_DIR/bin/"*; do
  backup_and_link "$file" "$HOME/.local/bin/$(basename "$file")"
done

# Git
backup_and_link "$DOTFILES_DIR/git/.gitconfig" "$HOME/.gitconfig"

# Readline
backup_and_link "$DOTFILES_DIR/readline/.inputrc" "$HOME/.inputrc"

# Starship
backup_and_link "$DOTFILES_DIR/starship/starship.toml" "$HOME/.config/starship.toml"

# VS Code
VSCODE_USER_DIR="$HOME/.config/Code/User"

backup_and_link "$DOTFILES_DIR/vscode/settings.json" "$VSCODE_USER_DIR/settings.json"
backup_and_link "$DOTFILES_DIR/vscode/keybindings.json" "$VSCODE_USER_DIR/keybindings.json"

# KDE Plasma
backup_and_link "$DOTFILES_DIR/kde/kglobalshortcutsrc" "$HOME/.config/kglobalshortcutsrc"


log "✅ Dotfiles installed successfully"
